    def carregar_logo(self):
        for nome in ["logo_icona.png", "LOGO_ICONA_PB_INVERSA.png", "LOGO_ICONA_PB_INVERSA.jpg", "LOGO_ICONA_PB_INVERSA-2.jpg"]:
