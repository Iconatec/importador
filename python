    VERDE = "#3F7659"
    VERMELHO = "#A33F35"

    def __init__(self, raiz: ctk.CTk):
        self.raiz = raiz
        self.modo_escuro = True
        self.logo = self.carregar_logo()
        self.caminho_pasta = ctk.StringVar()
