def corrente_extrair_conta_bb(texto: str) -> str:
    match = re.search(r"Conta corrente\s+(\d{1,20}-[A-Za-z0-9]{1,2})", texto, re.I)
    return match.group(1) if match else ""

def corrente_extrair_saldo_bb(texto: str) -> tuple[str, float]:
    padrao = re.compile(
        r"(\d{2}/\d{2}/\d{4})\s*"
        r"\n\s*\d+\s*"
        r"\n\s*\d+\s*"
        r"\n\s*\d+\s+S\s*A\s*L\s*D\s*O\s*"
        r"\n\s*(-?[\d.]+,\d{2})\s*([CD])",
        re.I,
    )

    matches = list(padrao.finditer(texto))

    if not matches:
        return "", 0.0

    ultimo = matches[-1]

    data = ultimo.group(1)
    valor = corrente_parse_br(ultimo.group(2))
    tipo = ultimo.group(3).upper()

    if valor is None:
        return "", 0.0

    saldo = float(valor)

    if tipo == "D":
        saldo = -saldo

    return data, saldo

def corrente_extrair_conta_abc(texto: str) -> str:
    # Normaliza o texto
    texto_normalizado = re.sub(r"\s+", " ", texto).strip()
    
    # Formato 1: Agência + Conta
    match = re.search(
        r"\bAg[êe]ncia\s*:\s*[\d.-]+\s+Conta\s*:\s*([0-9]{4,20}(?:-[A-Za-z0-9]{1,2})?)\b",
        texto_normalizado,
        re.I,
    )
    if match:
        return match.group(1)
    
    # Formato 2: Código do banco + Agência + Conta
    match = re.search(
        r"\b\d{4}\s*-\s*[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ0-9 .&/-]*?\s+\d{4,5}-[A-Za-z0-9]\s+([0-9]{4,20}(?:-[A-Za-z0-9]{1,2})?)\b",
        texto_normalizado,
        re.I,
    )
    if match:
        return match.group(1)
    
    # Formato 3: Fallback - apenas "Conta"
    match = re.search(
        r"\bConta\b\s*:?\s*([0-9]{4,20}(?:-[A-Za-z0-9]{1,2})?)\b",
        texto_normalizado,
        re.I,
    )
    if match:
        return match.group(1)
    
    return ""


def corrente_extrair_ultimo_lancamento_abc(texto: str) -> tuple[str, float]:
    # Procura por datas no formato dd/mm/aaaa
    datas = re.findall(r"(\d{2}/\d{2}/\d{4})", texto)
    
    # Procura por valores monetários no formato brasileiro (com separador de milhar e vírgula decimal)
    valores = re.findall(r"(-?[\d.]+,\d{2})", texto)
    
    # Pega a última data encontrada
    data = datas[-1] if datas else ""
    
    # Pega o último valor encontrado (que deve ser o saldo diário)
    if valores:
        saldo = corrente_parse_br(valores[-1])
        return data, float(saldo) if saldo is not None else 0.0
    
    return data, 0.0

def corrente_extrair_conta_itau(texto: str) -> str:
    match = re.search(r"Ag[êe]ncia\s+(\d+)\s+Conta\s+([0-9-]+)", texto, re.I)
    return match.group(2) if match else ""


def corrente_extrair_data_final_periodo_itau(texto: str) -> str:
    match = re.search(r"Lançamentos do período:\s*(\d{2}/\d{2}/\d{4})\s+até\s+(\d{2}/\d{2}/\d{4})", texto, re.I)
    return match.group(2) if match else ""


def corrente_extrair_data_saldo_itau(texto: str) -> tuple[str, float]:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    ocorrencias = []

    for indice, linha in enumerate(linhas):
        if not re.search(
            r"SALDO\s+TOTAL\s+DISPON[ÍI]VEL\s+DIA",
            linha,
            re.I,
        ):
            continue

        saldo = None

        # Procura o valor nas próximas 3 linhas depois da descrição do saldo
        for proxima_posicao in range(indice + 1, min(indice + 4, len(linhas))):
            match_valor = re.fullmatch(
                r"-?[\d.]+,\d{2}",
                linhas[proxima_posicao].replace("R$", "").strip(),
            )

            if match_valor:
                saldo = corrente_parse_br(match_valor.group(0))
                break

        if saldo is None:
            continue

        data = ""

        # Procura a data mais próxima acima da descrição do saldo
        for posicao in range(indice - 1, max(-1, indice - 11), -1):
            match_data = re.search(
                r"\b(\d{2}/\d{2}/\d{4})\b",
                linhas[posicao],
            )

            if match_data:
                data = match_data.group(1)
                break

        ocorrencias.append((data, float(saldo)))

    if not ocorrencias:
        return "", 0.0

    return ocorrencias[-1]

def corrente_extrair_nome_cliente_itau(texto: str) -> str:
    linhas = [linha.strip() for linha in texto.splitlines()]

    for indice, linha in enumerate(linhas):
        if not re.search(r"\bCNPJ\b", linha, re.I):
            continue

        for proxima_linha in linhas[indice + 1:]:
            nome = proxima_linha.strip()

            if not nome:
                continue

            if re.search(
                r"^(?:Saldo\s+total|Lançamentos|Período|Agência|Conta|Data)",
                nome,
                re.I,
            ):
                break

            if any(letra.isalpha() for letra in nome):
                return corrente_formatar_nome(nome)

    return ""

def corrente_extrair_nome_cliente_sicredi(texto: str) -> str:
    # Procura por "Associado:" e pega o texto na linha seguinte
    match = re.search(
        r"Associado\s*:\s*\n?\s*([A-Za-zÀ-ÿ0-9\s.&/-]+?)(?:\n|$)",
        texto,
        re.I,
    )
    if match:
        nome = match.group(1).strip()
        if nome and len(nome) > 3 and any(c.isalpha() for c in nome):
            return corrente_formatar_nome(nome)
    
    # Fallback para a função genérica
    return corrente_extrair_nome_cliente_generico(texto)


def corrente_extrair_conta_sicredi(texto: str) -> str:
    # Tenta padrões comuns de conta Sicredi (agência + conta ou apenas conta)
    match = re.search(
        r"\b(?:Ag[êe]ncia|Ag)\.?\s*[:\s]?\s*[\d.-]+\s+(?:Conta|Cc)\.?\s*[:\s]?\s*([0-9]{4,20}(?:-[A-Za-z0-9]{1,2})?)\b",
        texto,
        re.I,
    )
    if match:
        return match.group(1)

    match = re.search(
        r"\b(?:Conta|Cc)\.?\s*[:\s]?\s*([0-9]{4,20}(?:-[A-Za-z0-9]{1,2})?)\b",
        texto,
        re.I,
    )
    if match:
        return match.group(1)

    return ""


def corrente_extrair_saldo_sicredi(texto: str) -> tuple[str, float]:
    # O saldo é o número antes de "Lançamentos Futuros (Próximos 30 dias)"
    match = re.search(
        r"(-?[\d.]+,\d{2})\s*\n\s*Lançamentos Futuros\s*\(Próximos 30 dias\)",
        texto,
        re.I,
    )
    if match:
        saldo_str = match.group(1)
        saldo = corrente_parse_br(saldo_str)
        if saldo is not None:
            # Tenta achar a data associada (última data antes dessa linha)
            trecho_antes = texto[: match.start()]
            datas = re.findall(r"(\d{2}/\d{2}/\d{4})", trecho_antes)
            data = datas[-1] if datas else ""
            return data, float(saldo)

    return "", 0.0

def corrente_extrair_nome_cliente_xp(texto: str) -> str:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    for indice, linha in enumerate(linhas):
        if re.search(r"^Data da consulta\s*:", linha, re.I):
            if indice + 1 < len(linhas):
                nome = linhas[indice + 1]

                if (
                    nome
                    and any(letra.isalpha() for letra in nome)
                    and not re.search(
                        r"^(?:Conta|Assessor|Código assessor|De|Saldo disponível)\s*:",
                        nome,
                        re.I,
                    )
                ):
                    return corrente_formatar_nome(nome)

    return ""


def corrente_extrair_conta_xp(texto: str) -> str:
    match = re.search(
        r"Conta\s*:\s*([0-9.\-]+)",
        texto,
        re.I,
    )

    return match.group(1).strip() if match else ""


def corrente_extrair_data_final_periodo_xp(texto: str) -> str:
    match = re.search(
        r"De\s*:\s*\d{2}/\d{2}/\d{4}\s+Até\s*:\s*(\d{2}/\d{2}/\d{4})",
        texto,
        re.I,
    )

    return match.group(1) if match else ""


def corrente_extrair_data_saldo_xp(texto: str) -> tuple[str, float]:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    for indice, linha in enumerate(linhas):
        if not re.fullmatch(r"\d{2}/\d{2}/\d{4}", linha):
            continue

        data = linha
        valores = []

        for proxima_posicao in range(
            indice + 1,
            min(indice + 12, len(linhas)),
        ):
            linha_valor = linhas[proxima_posicao]

            match_valor = re.fullmatch(
                r"-?R\$\s*([\d.]+,\d{2})",
                linha_valor,
            )

            if not match_valor:
                continue

            valor = corrente_parse_br(match_valor.group(1))

            if valor is None:
                continue

            if linha_valor.startswith("-"):
                valor = -valor

            valores.append(float(valor))

            # Primeiro valor = movimentação; segundo valor = saldo
            if len(valores) == 2:
                return data, valores[1]

        break

    return "", 0.0

def corrente_extrair_conta_bradesco(texto: str) -> str:
    match = re.search(
        r"\bCC\s*:\s*([0-9]{4,20}(?:-[0-9A-Za-z]{1,2})?)",
        texto,
        re.I,
    )

    if match:
        return match.group(1)

    # Fallback: formato Agência | Conta, quando o PDF quebra os campos de linha
    match = re.search(
        r"(\d{4,20}(?:-[0-9A-Za-z]{1,2})?)\s*\|\s*Entre",
        texto,
        re.I,
    )

    return match.group(1) if match else ""

def corrente_extrair_data_final_periodo_bradesco(texto: str) -> str:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    # Localiza a última linha que contém exatamente "Total"
    indice_total = -1
    for indice, linha in enumerate(linhas):
        if linha.lower() == "total":
            indice_total = indice

    if indice_total == -1:
        return ""

    # Examina somente o trecho antes do último "Total"
    trecho_antes_total = "\n".join(linhas[:indice_total])

    # Localiza todas as datas e devolve a última encontrada
    datas = re.findall(
        r"\b(\d{2}/\d{2}/\d{4})\b",
        trecho_antes_total,
    )

    return datas[-1] if datas else ""

def corrente_extrair_saldo_bradesco(texto: str) -> float:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    # Localiza a última ocorrência literal de "Total"
    indice_total = -1
    for indice, linha in enumerate(linhas):
        if linha.strip().lower() == "total":
            indice_total = indice

    if indice_total == -1:
        return 0.0

    valores_encontrados = []

    # A partir do último Total, busca valores em linhas posteriores.
    for linha in linhas[indice_total + 1:]:
        match = re.fullmatch(
            r"-?[\d.]+,\d{2}",
            linha.replace("R$", "").strip(),
        )

        if match:
            valores_encontrados.append(match.group(0))

            # A regra é: terceiro número após o último "Total"
            if len(valores_encontrados) == 3:
                saldo = corrente_parse_br(valores_encontrados[2])
                return float(saldo) if saldo is not None else 0.0

        # Para não correr o risco de cruzar para outra seção extensa
        if re.search(r"^Saldos\s+Invest", linha, re.I):
            break

    return 0.0

def corrente_extrair_conta_safra(texto: str) -> str:
    match = re.search(
        r"CONTA\s*:\s*(\d{1,20}(?:-[A-Za-z0-9]{1,2})?)",
        texto,
        re.I,
    )

    return match.group(1) if match else ""


def corrente_extrair_ano_competencia_safra(texto: str) -> str:
    match = re.search(
        r"Per[ií]odo\s+de\s*\d{2}/\d{2}/(\d{4})",
        texto,
        re.I,
    )

    return match.group(1) if match else ""

def corrente_extrair_data_saldo_safra(texto: str) -> tuple[str, float]:
    ano = corrente_extrair_ano_competencia_safra(texto)

    saldos_totais = list(
        re.finditer(
            r"(\d{2}/\d{2})\s+SALDO\s+TOTAL\s+(-?[\d.]+,\d{2})",
            texto,
            re.I,
        )
    )

    if not saldos_totais:
        return "", 0.0

    primeira_data = saldos_totais[0].group(1)
    primeiro_dia = int(primeira_data.split("/")[0])

    if primeiro_dia <= 10:
        ultimo_saldo = saldos_totais[-1]
        data_sem_ano = ultimo_saldo.group(1)
        saldo = corrente_parse_br(ultimo_saldo.group(2))

    else:
        saldo_conta_corrente = re.search(
            r"(\d{2}/\d{2})\s+SALDO\s+CONTA\s+CORRENTE\s+"
            r"(-?[\d.]+,\d{2})",
            texto,
            re.I,
        )

        if not saldo_conta_corrente:
            return "", 0.0

        data_sem_ano = saldo_conta_corrente.group(1)
        saldo = corrente_parse_br(saldo_conta_corrente.group(2))

    if saldo is None:
        return "", 0.0

    data = f"{data_sem_ano}/{ano}" if ano else data_sem_ano

    return data, float(saldo)

def corrente_extrair_nome_cliente_safra(texto: str) -> str:
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]

    for indice, linha in enumerate(linhas):
        if re.search(r"\bCNPJ\s*:", linha, re.I):
            if indice == 0:
                break

            nome = linhas[indice - 1].strip()

            if (
                nome
                and any(letra.isalpha() for letra in nome)
                and not re.search(
                    r"^(?:Extrato|Per[ií]odo|Conta|Ag[eê]ncia|CNPJ)\b",
                    nome,
                    re.I,
                )
            ):
                return corrente_formatar_nome(nome)

    return ""





