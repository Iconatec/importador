def corrente_processar_todos_extratos(pasta_raiz: Path, callback=None):
    pastas = corrente_encontrar_pastas_corrente(pasta_raiz)
    if not pastas:
        raise FileNotFoundError(
            f"Nenhuma pasta '{CORRENTE_NOME_SUBPASTA_CORRENTE_CEF}' encontrada dentro de '{CORRENTE_NOME_PASTA_BANCO_CEF}'."
        )

    arquivos = [
        (pdf, banco)
        for pasta, banco in pastas
        for pdf in sorted(pasta.glob("*.pdf"))
    ] + [
        (pdf, banco)
        for pasta, banco in pastas
        for pdf in sorted(pasta.glob("*.PDF"))
    ]

    if not arquivos:
        raise FileNotFoundError("Nenhum arquivo PDF encontrado nas pastas de conta corrente.")

    resultados = []
    erros = []
    total = len(arquivos)

    processados = set()

    for indice, (arquivo, nome_banco) in enumerate(arquivos, start=1):
        if callback:
            callback(indice - 1, total, arquivo.name)

        nome_arquivo = arquivo.name
        if nome_arquivo in processados:
            if callback:
                callback(indice, total, arquivo.name)
            continue

        try:
            resultado = corrente_processar_arquivo(arquivo, nome_banco)
            resultados.append(resultado)
            if resultado["Status"] != "Processado":
                erros.append(f"{arquivo.name}: {resultado['Motivo']}")
        except Exception as erro:
            motivo = str(erro) or "Falha não identificada durante a leitura do PDF."
            resultados.append(corrente_registro_erro(arquivo, nome_banco, "Erro de leitura", motivo))
            erros.append(f"{arquivo.name}: {motivo}")

        processados.add(nome_arquivo)

        if callback:
            callback(indice, total, arquivo.name)

    return resultados, erros


def corrente_formatar_aba(ws, colunas: list[str], aplicar_moeda: bool = False):
    # Bordas
    borda_fina = Border(
        left=Side(style="thin", color="000000"),
        right=Side(style="thin", color="000000"),
        top=Side(style="thin", color="000000"),
        bottom=Side(style="thin", color="000000"),
    )

    # Cabeçalho
    preenchimento = PatternFill(fill_type="solid", fgColor=CORRENTE_COR_CABECALHO)
    fonte_branca = Font(color="FFFFFF", bold=True)
    alinhamento_centro = Alignment(horizontal="center", vertical="center")

    for col_idx in range(1, len(colunas) + 1):
        celula = ws.cell(row=1, column=col_idx)
        celula.fill = preenchimento
        celula.font = fonte_branca
        celula.border = borda_fina
        celula.alignment = alinhamento_centro

    # Dados
    alinhamento_esq = Alignment(horizontal="left", vertical="center")
    for linha in range(2, ws.max_row + 1):
        for col_idx in range(1, len(colunas) + 1):
            celula = ws.cell(row=linha, column=col_idx)
            celula.border = borda_fina
            celula.alignment = alinhamento_esq
            if aplicar_moeda and colunas[col_idx - 1] == "Saldo":
                celula.number_format = "#,##0.00"

    # Largura das colunas
    for idx, coluna in enumerate(colunas, start=1):
        letra_coluna = get_column_letter(idx)
        ws.column_dimensions[letra_coluna].width = 25

    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions


def corrente_salvar_planilha(extratos: list[dict], pasta_saida: Path) -> Path:
    caminho_saida = pasta_saida / CORRENTE_NOME_ARQUIVO_XLSX

    wb = Workbook()

    # Aba Extratos
    ws_extratos = wb.active
    ws_extratos.title = "Extratos"
    ws_extratos.append(CORRENTE_COLUNAS)

    for registro in extratos:
        if registro.get("Status") == "Processado":
            ws_extratos.append([
                registro.get(coluna, "")
                for coluna in CORRENTE_COLUNAS
            ])

    corrente_formatar_aba(ws_extratos, CORRENTE_COLUNAS, aplicar_moeda=True)

    # Aba Erros de leitura
    ws_erros = wb.create_sheet("Erros de leitura")
    ws_erros.append(CORRENTE_COLUNAS_ERROS)

    for registro in extratos:
        if registro.get("Status") != "Processado":
            ws_erros.append([
                registro.get(coluna, "")
                for coluna in CORRENTE_COLUNAS_ERROS
            ])

    corrente_formatar_aba(ws_erros, CORRENTE_COLUNAS_ERROS, aplicar_moeda=False)

    wb.save(caminho_saida)
    return caminho_saida


