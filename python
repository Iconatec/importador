def aplicacao_processar_extrato_bradesco(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = aplicacao_extrair_texto_pdf(caminho_pdf)
    dados = aplicacao_extrair_blocos_total_bradesco(texto_original)
    blocos = dados["blocos"]

    resultado = {coluna: "" for coluna in APLICACAO_COLUNAS}
    resultado.update({
        "Arquivo": caminho_pdf.stem,
        "Cliente": aplicacao_extrair_nome_cliente_bradesco(texto_original),
        "Conta": aplicacao_extrair_conta_bradesco(texto_original),
        "Mês": aplicacao_extrair_mes_bradesco(texto_original),
        "Saldo Anterior": 0.0,
        "Aplicações": 0.0,
        "Resgates": 0.0,
        "Rendimento bruto mês": 0.0,
        "IRRF": 0.0,
        "IOF": 0.0,
        "Saldo Bruto": 0.0,
        "Banco": "Bradesco",
    })

    if len(blocos) < 4:
        return resultado

    def valor(bloco, indice):
        valores = bloco.get("valores", [])
        return aplicacao_numero_br(valores[indice]) if len(valores) > indice else 0.0

    bloco_saldo_anterior = blocos[0]
    bloco_aplicacoes = blocos[1]
    bloco_resgates = blocos[2]
    bloco_saldo_final = blocos[-1]

    # Índices após remover o 0,0000:
    # 0 = Vlr. Princ.
    # 1 = Vlr. Bruto
    # 2 = Renda Total
    # 3 = Vlr. IOF
    # 4 = Vlr. IRRF
    # 5 = Vlr. Líquido
    # 6 = Renda Bruta Per

    resultado["Saldo Anterior"] = valor(bloco_saldo_anterior, 1)
    resultado["Aplicações"] = valor(bloco_aplicacoes, 0)
    resultado["Resgates"] = valor(bloco_resgates, 5)
    resultado["IRRF"] = valor(bloco_resgates, 4)
    resultado["IOF"] = valor(bloco_resgates, 3)
    resultado["Rendimento bruto mês"] = (
        valor(bloco_resgates, 6)
        + valor(bloco_saldo_final, 6)
    )
    resultado["Saldo Bruto"] = valor(bloco_saldo_final, 1)

    return resultado




