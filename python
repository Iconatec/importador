def aplicacao_valores_itau_fundos(
    texto: str,
    rotulo: str,
) -> list[float]:
    padrao = (
        rf"{rotulo}"
        rf"\s*"
        rf"(?:\n|\s)+"
        rf"((?:[0-9.]+,\d{{2,5}})"
        rf"(?:\s+(?:[0-9.]+,\d{{2,5}}))*)"
    )

    encontrados = list(
        re.finditer(
            padrao,
            texto,
            re.I,
        )
    )

    if not encontrados:
        return []

    trecho = encontrados[-1].group(1)

    numeros = re.findall(
        r"[0-9.]+,\d{2,5}",
        trecho,
    )

    return [
        aplicacao_texto_para_numero(numero)
        for numero in numeros
    ]


def aplicacao_valor_itau_reais(
    texto: str,
    rotulo: str,
) -> float:
    valores = aplicacao_valores_itau_fundos(
        texto,
        rotulo,
    )

    if not valores:
        return 0.0

    # Nos fundos do Itaú, a primeira coluna é quantidade
    # de cotas e a segunda coluna é o valor em reais.
    if len(valores) >= 2:
        return valores[1]

    return valores[0]

