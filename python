def aplicacao_extrair_blocos_total_bradesco(texto: str):
    linhas = [linha.strip() for linha in texto.splitlines() if linha.strip()]
    blocos = []
    operacoes = []
    i = 0

    padrao_data = re.compile(r"^\d{2}/\d{2}/\d{4}$")
    padrao_numero = re.compile(r"^\d{1,3}(?:\.\d{3})*,\d{2,4}$")

    while i < len(linhas):
        linha = linhas[i]

        if padrao_data.fullmatch(linha):
            operacao = {
                "dt_aplicacao": linha,
                "dt_vencto": "",
                "dt_resgate": "",
            }

            if i + 1 < len(linhas) and padrao_data.fullmatch(linhas[i + 1]):
                operacao["dt_vencto"] = linhas[i + 1]

            if i + 2 < len(linhas) and padrao_data.fullmatch(linhas[i + 2]):
                operacao["dt_resgate"] = linhas[i + 2]

            operacoes.append(operacao)
            i += 1
            continue

        if linha.lower() == "total":
            numeros = []
            j = i + 1

            while j < len(linhas):
                encontrados = re.findall(
                    r"\d{1,3}(?:\.\d{3})*,\d{2,4}",
                    linhas[j],
                )

                if not encontrados:
                    break

                numeros.extend(encontrados)
                j += 1

            # O valor 0,0000 é a taxa e não pertence às colunas financeiras.
            numeros = [numero for numero in numeros if numero != "0,0000"]

            if len(numeros) >= 7:
                blocos.append({
                    "valores": numeros[:7],
                    "operacoes": operacoes.copy(),
                })

            operacoes = []
            i = j
            continue

        i += 1

    return {
        "linhas": linhas,
        "blocos": blocos,
    }



def aplicacao_extrair_nome_cliente_bradesco(texto: str) -> str:
