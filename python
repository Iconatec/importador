def corrente_extrair_texto_pdf(caminho_pdf: Path) -> str:
    doc = fitz.open(caminho_pdf)
    try:
        return "".join(pagina.get_text() for pagina in doc)
    finally:
        doc.close()


def corrente_parse_br(valor: str) -> Decimal | None:
    try:
        s = str(valor).strip()
        if not s:
            return None
        s = s.replace(".", "").replace(",", ".")
        return Decimal(s)
    except (InvalidOperation, ValueError):
        return None


def corrente_texto_para_numero(valor) -> float:
    if not valor or valor == "0,00":
        return 0.0
    valor = str(valor).replace("R$", "").replace(" ", "")
    negativo = valor.startswith("-")
    valor = valor.lstrip("-")
    try:
        numero = float(valor.replace(".", "").replace(",", "."))
        return -numero if negativo else numero
    except ValueError:
        return 0.0


def corrente_formatar_nome(nome: str) -> str:
    nome = re.sub(r"\n+", " ", nome)
    nome = re.sub(r"\s+", " ", nome).strip().lower()
    nome = re.sub(r"\b\w", lambda m: m.group(0).upper(), nome)
    for p, r in [
        (r"\bSpe\b", "SPE"),
        (r"\bLtda\b", "LTDA"),
        (r"\bS/a\b", "S/A"),
        (r"\bEireli\b", "EIRELI"),
        (r"\bMe\b", "ME"),
        (r"\bEpp\b", "EPP"),
    ]:
        nome = re.sub(p, r, nome, flags=re.I)
    return nome


def corrente_extrair_nome_cliente_generico(texto_original: str) -> str:
    match = re.search(
        r"Cliente[\s\S]*?Nome\s*\n\s*([\s\S]*?)"
        r"(?=\n\s*(?:CPF\/CNPJ|Conta Corrente|M[eê]s/Ano|Folha|An[aá]lise do Perfil do Investidor|Data da Avalia[cç][aã]o)\b)",
        texto_original,
        re.I,
    )
    if match:
        return corrente_formatar_nome(match.group(1))
    m = re.search(r"Cliente:\s*(.+?)(?:\n|$)", texto_original, re.IGNORECASE)
    if m:
        return corrente_formatar_nome(m.group(1))
    return ""

def corrente_extrair_nome_cliente_abc(texto: str) -> str:
    linhas = texto.splitlines()
    
    for i, linha in enumerate(linhas):
        if "CNPJ" in linha:
            # Pega a linha anterior ao CNPJ
            if i > 0:
                nome = linhas[i - 1].strip()
                if nome and len(nome) > 3:
                    return corrente_formatar_nome(nome)
    
    return corrente_extrair_nome_cliente_generico(texto)


def corrente_extrair_nome_cliente_bb(texto: str) -> str:
    # Normaliza o texto para tratar quebras de linha
    texto_normalizado = re.sub(r"\s+", " ", texto)
    
    # Procura por 'Conta corrente' seguido de número e nome
    match = re.search(
        r"Conta\s+corrente\s+[\d.\s]*?(\d{1,20}-[A-Za-z0-9]{1,2})\s+([A-Za-zÀ-ÿ0-9\s.&/-]+?)(?:\s+Período|\s+Agência|\s+Conta|\n|$)",
        texto_normalizado,
        re.I,
    )
    
    if match:
        nome = match.group(2).strip()
        return corrente_formatar_nome(nome)
    
    # Fallback: usa a função genérica
    return corrente_extrair_nome_cliente_generico(texto)

def corrente_mes_ano_competencia(texto: str) -> tuple[int, int] | None:
    mapa_meses = {
        "janeiro": 1,
        "fevereiro": 2,
        "marco": 3,
        "março": 3,
        "abril": 4,
        "maio": 5,
        "junho": 6,
        "julho": 7,
        "agosto": 8,
        "setembro": 9,
        "outubro": 10,
        "novembro": 11,
        "dezembro": 12,
    }

    m = re.search(
        r"M[êe]s:\s*([A-Za-zÀ-ÿ]+)\s*/\s*(\d{4})",
        texto,
        re.IGNORECASE,
    )
    if not m:
        return None

    nome_mes = m.group(1).lower()
    nome_mes_normalizado = (
        nome_mes.replace("ç", "c")
        .replace("ã", "a")
        .replace("õ", "o")
        .replace("á", "a")
        .replace("é", "e")
        .replace("í", "i")
        .replace("ó", "o")
        .replace("ú", "u")
    )

    mes = mapa_meses.get(nome_mes_normalizado)
    if not mes:
        return None

    ano = int(m.group(2))
    return mes, ano


def corrente_extrair_conta_caixa(texto: str) -> str:
    match = re.search(r"Conta Corrente\s*\n?[\d.]*000(\d{6,20})\s*-\s*(\d)", texto, re.I)
    if match:
        return f"{match.group(1)}-{match.group(2)}"
    match = re.search(r"\d+\s*/\s*\d+\s*/\s*(\d{6,20})\s*-\s*(\d)", texto)
    if match:
        return f"{match.group(1)}-{match.group(2)}"
    m = re.search(r"Conta:\s*([0-9|.\- ]+)", texto, re.IGNORECASE)
    if not m:
        return ""
    candidato = m.group(1).strip()
    m2 = re.search(r"(\d{4,}-\d)\b", candidato)
    if m2:
        return m2.group(1)
    return candidato.replace(" ", "")


def corrente_extrair_ultimo_saldo_dia_caixa(
    texto: str,
    competencia: tuple[int, int] | None,
) -> tuple[str, float]:
    padrao = re.compile(
        r"(\d{2}/\d{2}/\d{4})\s+\d+\s+SALDO\s+DIA\s+\d+,\d{2}\s+C\s+([-\d\.]+,\d{2})\s+C",
        re.IGNORECASE,
    )

    registros = []
    for m in padrao.finditer(texto):
        data_str = m.group(1)
        valor_str = m.group(2)
        saldo = corrente_parse_br(valor_str)
        if saldo is None:
            continue

        try:
            dia, mes, ano = map(int, data_str.split("/"))
        except Exception:
            continue

        registros.append(
            {
                "data_str": data_str,
                "dia": dia,
                "mes": mes,
                "ano": ano,
                "saldo": saldo,
            }
        )

    if not registros:
        return "", 0.0

    if competencia:
        mes_alvo, ano_alvo = competencia
        filtrados = [
            r for r in registros if r["mes"] == mes_alvo and r["ano"] == ano_alvo
        ]
        if filtrados:
            registros = filtrados

    registros.sort(key=lambda r: (r["ano"], r["mes"], r["dia"]))
    ultimo = registros[-1]

    return ultimo["data_str"], float(ultimo["saldo"])


def corrente_formatar_conta(conta: str) -> str:
    if not conta:
        return ""

    conta_apenas_numeros = re.sub(r"\D", "", str(conta))
    conta_limpa = conta_apenas_numeros.lstrip("0")

    return conta_limpa if conta_limpa else "0"


