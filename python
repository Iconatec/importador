    provisionado_anterior = re.search(
        r"([\d.]+,\d{2})\s+\d{2}/\d{2}/\d{4}\s+Rendimentos Provisionados:",
        texto,
        re.I,
    )

    saldo_anterior = re.search(
        r"([\d.]+,\d{2})\s+\d{2}/\d{2}/\d{4}\s+Saldo Anterior:",
        texto,
        re.I,
    )

    valor_provisionado_anterior = (
        aplicacao_texto_para_numero(provisionado_anterior.group(1))
        if provisionado_anterior
        else 0.0
    )

    valor_saldo_anterior = (
        aplicacao_texto_para_numero(saldo_anterior.group(1))
        if saldo_anterior
        else 0.0
    )

    saldo_anterior_total = valor_saldo_anterior + valor_provisionado_anterior

    tabela = re.search(
        r"(\d{2}/\d{4})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})\s+"
        r"([\d.]+,\d{2})",
        texto,
    )

    pos = re.search(
        r"Saldo Atual\s+([\d.]+,\d{2})\s*Rendimentos Provisionados",
        texto,
        re.I,
    )

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": aplicacao_extrair_cliente_sicredi(texto_original),
        "Conta": aplicacao_extrair_conta_sicredi_prazo(texto_original),
        "Mês": aplicacao_extrair_mes_sicredi(texto_original),
        "Saldo Anterior": saldo_anterior_total,
        "Aplicações": aplicacao_texto_para_numero(tabela.group(2)) if tabela else 0.0,
        "Resgates": aplicacao_texto_para_numero(tabela.group(3)) if tabela else 0.0,
        "Rendimento bruto mês": aplicacao_texto_para_numero(tabela.group(7)) if tabela else 0.0,
        "IRRF": aplicacao_texto_para_numero(tabela.group(5)) if tabela else 0.0,
        "IOF": aplicacao_texto_para_numero(tabela.group(6)) if tabela else 0.0,
        "Saldo Bruto": (
            aplicacao_texto_para_numero(pos.group(1)) if pos else 0.0
        ) + (
            aplicacao_texto_para_numero(tabela.group(8)) if tabela else 0.0
        ),
        "Banco": nome_banco,
    }


def aplicacao_processar_extrato_xp(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = aplicacao_extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()
    match = re.search(r"[a-z]+\./\d{2}\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.-]+,\d{2})\s+-R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})\s+R\$\s*([\d.]+,\d{2})", texto, re.I)
    saldo_anterior = aplicacoes = resgates = rendimentos = irrf = iof = saldo_bruto = 0.0
    if match:
        saldo_anterior = aplicacao_texto_para_numero(match.group(1))
        movimentacoes = aplicacao_texto_para_numero(match.group(2))
        irrf = aplicacao_texto_para_numero(match.group(3))
        iof = aplicacao_texto_para_numero(match.group(4))
        saldo_bruto = aplicacao_texto_para_numero(match.group(5))
        rendimentos = aplicacao_texto_para_numero(match.group(6))
        if movimentacoes >= 0:
            aplicacoes = movimentacoes
        else:
            resgates = abs(movimentacoes)
    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": "",
        "Conta": aplicacao_extrair_conta_xp(texto_original),
        "Mês": aplicacao_extrair_mes_xp(texto_original),
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates,
        "Rendimento bruto mês": rendimentos,
        "IRRF": irrf,
        "IOF": iof,
        "Saldo Bruto": saldo_bruto,
        "Banco": nome_banco,
    }


def aplicacao_processar_extrato_itau(caminho_pdf: Path, nome_banco: str) -> dict:
    texto_original = aplicacao_extrair_texto_pdf(caminho_pdf)
    texto = re.sub(r"\s+", " ", texto_original).strip()
    acumulado = re.search(r"Acum\.\s*M[eê]s\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})\s+([\d.]+,\d{2})", texto, re.I)
    anterior = re.search(r"\b31/\d{2}/\d{4}\s+([\d.]+,\d{2})\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}\s+[\d.]+,\d{2}", texto)
    linhas = [l.strip() for l in texto_original.splitlines() if l.strip()]
    saldo_bruto = 0.0
    for i, linha in enumerate(linhas):
        if re.fullmatch(r"\d{2}/\d{2}/\d{4}", linha) and i + 1 < len(linhas):
            if re.fullmatch(r"[\d.]+,\d{2}", linhas[i + 1]):
                saldo_bruto = aplicacao_texto_para_numero(linhas[i + 1])
    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": aplicacao_extrair_cliente_itau(texto_original),
        "Conta": aplicacao_extrair_conta_itau(texto_original),
        "Mês": aplicacao_extrair_mes_itau(texto_original),
        "Saldo Anterior": aplicacao_texto_para_numero(anterior.group(1)) if anterior else 0.0,
        "Aplicações": aplicacao_texto_para_numero(acumulado.group(1)) if acumulado else 0.0,
        "Resgates": aplicacao_texto_para_numero(acumulado.group(6)) if acumulado else 0.0,
        "Rendimento bruto mês": aplicacao_texto_para_numero(acumulado.group(7)) if acumulado else 0.0,
        "IRRF": aplicacao_texto_para_numero(acumulado.group(5)) if acumulado else 0.0,
        "IOF": aplicacao_texto_para_numero(acumulado.group(4)) if acumulado else 0.0,
        "Saldo Bruto": saldo_bruto,
        "Banco": "Itaú",
    }


def aplicacao_processar_extrato_itau_fundos(
    caminho_pdf: Path,
    nome_banco: str,
) -> dict:
    texto_original = aplicacao_extrair_texto_pdf(caminho_pdf)

    texto = texto_original.replace(
        "\xa0",
        " ",
    )

    conta = ""
    cliente = ""

    match_cabecalho = re.search(
        r"Ag\./Conta\s+"
        r"(\d{1,5})/(\d{1,20}-\d+)",
        texto,
        re.I,
    )

    if match_cabecalho:
        conta = match_cabecalho.group(2)

    match_cliente = re.search(
        r"Folha\s+\d+/\d+\s*"
        r"([^\n]+?)\s*"
        r"FI\d+",
        texto,
        re.I,
    )

    if match_cliente:
        cliente = aplicacao_formatar_nome(
            match_cliente.group(1)
        )

    match_periodo = re.search(
        r"Período:\s*"
        r"\d{2}/\d{2}\s+a\s+"
        r"(\d{2})/(\d{2})/(\d{4})",
        texto,
        re.I,
    )

    mes = ""

    if match_periodo:
        mes = (
            f"{match_periodo.group(2)}/"
            f"{match_periodo.group(3)}"
        )

    saldo_anterior = aplicacao_valor_itau_reais(
        texto,
        r"SALDO\s+BRUTO\s+ANTERIOR",
    )
    
    aplicacoes = aplicacao_valor_itau_reais(
        texto,
        r"APLICACOES",
    )
    
    resgate_bruto = aplicacao_valor_itau_reais(
        texto,
        r"RESGATES",
    )
    
    rendimento_mes = aplicacao_valor_itau_reais(
        texto,
        r"RENDIMENTO\s+BRUTO\s+NO\s+MES",
    )
    
    saldo_bruto = aplicacao_valor_itau_reais(
        texto,
        r"SALDO\s+BRUTO\s+ATUAL",
    )
    
    iof = aplicacao_valor_itau_reais(
        texto,
        r"TOTAL\s+SUJEITO\s+A\s+IOF",
    )
    
    irrf = aplicacao_valor_itau_reais(
        texto,
        r"IR\s+RETIDO\s+NO\s+PERIODO",
    )
    
    resgates_liquidos = max(
        resgate_bruto - irrf,
        0.0,
    )

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": cliente,
        "Conta": conta,
        "Mês": mes,
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates_liquidos,
        "Rendimento bruto mês": rendimento_mes,
        "IRRF": irrf,
        "IOF": iof,
        "Saldo Bruto": saldo_bruto,
        "Banco": "Itaú",
    }

def aplicacao_processar_extrato_safra(
    caminho_pdf: Path,
    nome_banco: str,
) -> dict:
    texto_original = aplicacao_extrair_texto_pdf(caminho_pdf)

    texto = texto_original.replace(
        "\xa0",
        " ",
    )

    conta = ""

    match_conta = re.search(
        r"Ag[êe]ncia:\s*\d+\s*/\s*"
        r"Conta:\s*([^\n]+)",
        texto,
        re.I,
    )

    if match_conta:
        conta = match_conta.group(1).strip()

    mes = ""

    match_data = re.search(
        r"Data\s+da\s+posi[cç][ãa]o:\s*"
        r"\d{2}/(\d{2})/(\d{4})",
        texto,
        re.I,
    )

    if match_data:
        mes = (
            f"{match_data.group(1)}/"
            f"{match_data.group(2)}"
        )

    marcador_inicio = re.search(
        r"Investimentos\s+Resumo\s+Composi[cç][ãa]o",
        texto,
        re.I,
    )

    if not marcador_inicio:
        return {
            "Arquivo": caminho_pdf.stem,
            "Cliente": "",
            "Banco": "Safra",
            "Conta": conta,
            "Mês": mes,
            "Saldo Anterior": 0.0,
            "Aplicações": 0.0,
            "Resgates": 0.0,
            "Rendimento bruto mês": 0.0,
            "IRRF": 0.0,
            "IOF": 0.0,
            "Saldo Bruto": 0.0,
        }

    texto_composicao = texto[
        marcador_inicio.end():
    ]

    marcador_renda_fixa = re.search(
        r"\bRENDA\s+FIXA\b",
        texto_composicao,
        re.I,
    )

    if not marcador_renda_fixa:
        return {
            "Arquivo": caminho_pdf.stem,
            "Cliente": "",
            "Banco": "Safra",
            "Conta": conta,
            "Mês": mes,
            "Saldo Anterior": 0.0,
            "Aplicações": 0.0,
            "Resgates": 0.0,
            "Rendimento bruto mês": 0.0,
            "IRRF": 0.0,
            "IOF": 0.0,
            "Saldo Bruto": 0.0,
        }

    texto_valores = texto_composicao[
        marcador_renda_fixa.end():
    ]

    tokens = re.findall(
        r"-|[0-9.]+,\d{2}",
        texto_valores,
    )

    valores = []

    for token in tokens:
        if token == "-":
            valores.append(0.0)
        else:
            valores.append(
                aplicacao_texto_para_numero(token)
            )

        if len(valores) == 8:
            break

    while len(valores) < 8:
        valores.append(0.0)

    (
        saldo_anterior,
        aplicacoes,
        resgates,
        impostos_incorridos,
        rendimento,
        saldo_bruto,
        impostos_previstos,
        saldo_liquido,
    ) = valores[:8]

    return {
        "Arquivo": caminho_pdf.stem,
        "Cliente": "",
        "Banco": "Safra",
        "Conta": conta,
        "Mês": mes,
        "Saldo Anterior": saldo_anterior,
        "Aplicações": aplicacoes,
        "Resgates": resgates,
        "Rendimento bruto mês": rendimento,
        "IRRF": impostos_incorridos,
        "IOF": 0.0,
        "Saldo Bruto": saldo_bruto,
    }






